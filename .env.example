# Copy this file to .env.local and fill in the actual values.

# Required: Anthropic API key for Claude calls (parser, report, bid generation).
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional in local dev (file-based DB takes over when these are absent).
# Required in production — populated automatically when you provision Vercel KV
# from the Vercel dashboard. Pull locally with: npx vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
